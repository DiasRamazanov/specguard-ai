{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "quote",
            "absence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "location"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "line_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "required": [
        "document_id",
        "block_id"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "scope": {
      "enum": [
        "individual",
        "global"
      ],
      "title": "Scope",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "explanation": {
      "title": "Explanation",
      "type": "string"
    },
    "criterion": {
      "title": "Criterion",
      "type": "string"
    },
    "severity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "informational"
      ],
      "title": "Severity",
      "type": "string"
    },
    "status": {
      "enum": [
        "confirmed",
        "requires_clarification",
        "context_dependent"
      ],
      "title": "Status",
      "type": "string"
    },
    "document_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Document Ids",
      "type": "array"
    },
    "requirement_ids": {
      "items": {
        "type": "string"
      },
      "title": "Requirement Ids",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "impact": {
      "title": "Impact",
      "type": "string"
    },
    "recommendation": {
      "title": "Recommendation",
      "type": "string"
    },
    "uncertainty": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty"
    },
    "conflict_scenario": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conflict Scenario"
    },
    "review_explanation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Explanation"
    },
    "counterevidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Counterevidence",
      "type": "array"
    }
  },
  "required": [
    "finding_id",
    "kind",
    "scope",
    "title",
    "explanation",
    "criterion",
    "severity",
    "status",
    "document_ids",
    "evidence",
    "impact",
    "recommendation"
  ],
  "title": "Finding",
  "type": "object"
}
